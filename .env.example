# TeamoRouter uses an OpenAI-compatible API.
LLM_BASE_URL=https://api.teamorouter.com/v1
LLM_API_KEY=replace-with-your-teamrouter-api-key
# Use the model ID shown in TeamoRouter Dashboard > Routing.
LLM_MODEL_NAME=gpt-5.6-terra
# QWeather credentials for utils/spider_weather.py.
QWEATHER_API_KEY=replace-with-your-qweather-api-key
# Use the API host associated with the key in your QWeather project.
QWEATHER_BASE_URL=https://devapi.qweather.com/v7/weather/30d
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=travel_rag
# Alibaba Cloud Market train ticket API (optional; used for train queries).
TRAIN_API_BASE_URL=https://jisutrainf.market.alicloudapi.com/train/station2s
TRAIN_API_APPCODE=replace-with-your-alicloud-appcode
ATTRACTION_API_BASE_URL=https://jmqgjdcx.market.alicloudapi.com/area/scenic-spots
ATTRACTION_API_APPCODE=replace-with-your-alicloud-appcode
